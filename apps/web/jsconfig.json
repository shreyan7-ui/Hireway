{
    "compilerOptions": {
        "paths": {
            "@/*": ["./*"]
        },
        "checkJs": false,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "preserve"
    },
    "include": [
        "**/*.js",
        "**/*.jsx"
    ],
    "exclude": [
        "node_modules",
        ".next"
    ]
}
